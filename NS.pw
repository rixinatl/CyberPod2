SERVER NSWS
  PROCESSTYPE OSS
  ARGLIST -cp,config,-Djava.library.path=/usr/tandem/javaexth11/lib,-jar,
    lib/NonStopWS-current.jar
  AUTORESTART 5
  CPUS (0)
  CREATEDELAY 1 MINS
  CWD /opt/relayhealth/van/NonStopWS
  DEBUG OFF
  DEFINE =TCPIP^HOST^FILE,CLASS MAP,FILE \FE6.$SYSTEM.ZTCPIP.HOSTS
  DEFINE =TCPIP^PROCESS^NAME,CLASS MAP,FILE \FE6.$ZTC0
  DELETEDELAY 10 MINS
  ENV TCPIP_RESOLVER_ORDER=HOSTFILE-DNS
  HIGHPIN OFF
  HOMETERM \FE6.$ZHOME
  LINKDEPTH 1
  MAXLINKS 1
  MAXSERVERS 1
  NUMSTATIC 1
  OWNER \FE6.250,60
  PRI 180
  PROCESS $NSWS
  PROGRAM /usr/tandem/nssjava/jdk170_l17/bin/java
  SECURITY "U"
  STDERR logs/nsws.err
  STDIN /dev/null
  STDOUT logs/nsws.out
  TIMEOUT 30 SECS
  TMF OFF
  UMASK 77
  VOLUME \FE6.$D01.HCFRONT

